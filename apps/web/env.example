# Copy to .env.local (never commit .env.local)
# Run: ./scripts/setup-env.sh
#
# Deployment environment: LOCAL (next dev + Docker Postgres)
# For Cloudflare preview see .dev.vars.example (local-cf).
# For staging/production see docs/DEPLOY_SECRETS.md (GitHub Environments).

# -----------------------------------------------------------------------------
# DATABASE_URL — direct PostgreSQL (required for pnpm dev / pnpm db:setup locally)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://polyagent:polyagent@localhost:5432/polyagent

GAMMA_API_BASE=https://gamma-api.polymarket.com
MARKET_CACHE_TTL_SECONDS=60
SCHEDULER_MODE=docker
MAX_ACTIVE_BOTS=10
SNAPSHOT_HARVEST_ENABLED=true
SNAPSHOT_HARVEST_TOP_N=20
SNAPSHOT_HARVEST_MARKET_IDS=
SNAPSHOT_HARVEST_MIN_INTERVAL_SECONDS=240
SNAPSHOT_RETENTION_DAYS=30

# Optional auth (leave empty for open local dashboard)
DASHBOARD_PASSWORD=
SESSION_SECRET=
CRON_SECRET=local-dev-cron-secret